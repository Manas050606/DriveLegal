# ==========================================
# API CONFIGURATION
# ==========================================

VITE_API_URL=http://localhost:5000/api


# ==========================================
# APPLICATION CONFIG
# ==========================================

VITE_APP_NAME=DriveLegal AI

VITE_APP_VERSION=1.0.0

VITE_COMPANY_NAME=DriveLegal Technologies


# ==========================================
# AI SYSTEM CONFIG
# ==========================================

VITE_ENABLE_AI_MONITORING=true

VITE_ENABLE_FRAUD_DETECTION=true

VITE_ENABLE_OCR=true

VITE_ENABLE_ANALYTICS=true


# ==========================================
# FILE UPLOAD CONFIG
# ==========================================

VITE_MAX_FILE_SIZE=10485760

VITE_ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/jpg

VITE_ALLOWED_DOCUMENT_TYPES=application/pdf,image/png,image/jpeg,image/jpg


# ==========================================
# DASHBOARD CONFIG
# ==========================================

VITE_ENABLE_LIVE_MONITORING=true

VITE_ENABLE_QR_SCANNER=true

VITE_ENABLE_ADMIN_PANEL=true


# ==========================================
# SECURITY CONFIG
# ==========================================

VITE_SESSION_TIMEOUT=3600000

VITE_MAX_LOGIN_ATTEMPTS=5


# ==========================================
# DEVELOPMENT MODE
# ==========================================

VITE_DEV_MODE=true
VITE_API_URL=http://127.0.0.1:8000/api